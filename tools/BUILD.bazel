load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:objc_library.bzl", "objc_library")

cc_binary(
    name = "raag_catalog",
    srcs = ["raag_catalog.cpp"],
    deps = ["//core"],
)

cc_binary(
    name = "analyze",
    srcs = ["analyze.cpp"],
    deps = [
        "//core",
        "//platform:audio_file",
    ],
)

objc_library(
    name = "plot_main",
    srcs = ["plot.mm"],
    sdk_frameworks = [
        "CoreGraphics",
        "Foundation",
        "ImageIO",
        "UniformTypeIdentifiers",
    ],
    deps = [
        "//core",
        "//platform:audio_file",
        "//platform:pitch_plot",
    ],
)

cc_binary(
    name = "plot",
    deps = [":plot_main"],
)

objc_library(
    name = "record_main",
    srcs = ["record.mm"],
    sdk_frameworks = [
        "AVFoundation",
        "Foundation",
    ],
    deps = ["//platform:audio_input"],
)

cc_binary(
    name = "record",
    deps = [":record_main"],
)

cc_binary(
    name = "evaluate",
    srcs = ["evaluate.cpp"],
    deps = [
        ":evaluation",
        ":joint_diagnostics",
        "//core",
        "//platform:audio_file",
    ],
)

cc_library(
    name = "joint_diagnostics",
    srcs = ["joint_diagnostics.cpp"],
    hdrs = ["joint_diagnostics.h"],
    deps = ["//core"],
)

cc_test(
    name = "joint_diagnostics_test",
    size = "small",
    srcs = ["joint_diagnostics_test.cpp"],
    deps = [
        ":joint_diagnostics",
        "//core",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "evaluation",
    srcs = ["evaluation.cpp"],
    hdrs = ["evaluation.h"],
    deps = ["//core"],
    visibility = ["//app/macos:__pkg__"],
)

cc_test(
    name = "evaluation_test",
    size = "small",
    srcs = ["evaluation_test.cpp"],
    deps = [
        ":evaluation",
        "@googletest//:gtest_main",
    ],
)
